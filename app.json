{
  "expo": {
    "name": "AquaLingua",
    "slug": "langlearnpro",
    "version": "1.0.3",
    "owner": "muratcansahindev",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "com.muratcansahn.aqualingua.app",
    "userInterfaceStyle": "automatic",
    "warnings": false,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "packagerOpts": {
      "config": "metro.config.js"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muratcansahn.aqualingua.app",
      "usesAppleSignIn": true,
      "displayName": "AquaLingua",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Bu uygulama ses özellikleri için mikrofon izni ister.",
        "NSSpeechRecognitionUsageDescription": "Bu uygulama konuşma tanıma özellikleri için izin ister.",
        "NSCameraUsageDescription": "Bu uygulama profil fotoğrafı çekmek için kamera izni ister.",
        "NSPhotoLibraryUsageDescription": "Bu uygulama fotoğraf seçmek için fotoğraf kütüphanesine erişim izni ister.",
        "NSPhotoLibraryAddUsageDescription": "Bu uygulama fotoğrafları kaydetmek için fotoğraf kütüphanesine erişim izni ister.",
        "NSUserTrackingUsageDescription": "Bu tanımlayıcı, size kişiselleştirilmiş içerik sunmak için kullanılacaktır.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "facebook",
          "facebook-stories"
        ],
        "GADApplicationIdentifier": "ca-app-pub-2920147810768385~3189350636"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.langlearnpro.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.muratcansahn.aqualingua.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router","expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.618549544946-6qbr87l7njjfksht904vsp5f9ckc65kr",
          "scopes": [
            "profile",
            "email"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "58803994-0235-44df-8c4c-8d8d0d782307"
      }
    }
  }
}
