#* Description: Environment variables for the Expo app
#? Usage: Copy this file to the root of the project and replace the values with your own
#! IMPORTANT: Do not commit this file to the repository
#! IMPORTANT - 2: Do not share this file with anyone
#! VERY IMPORTANT:  Must be start with EXPO_PUBLIC_ prefix

#* In this repo: We are using Supabase as the backend
#! Must be start with EXPO_PUBLIC_ prefix



#TODO: Firstly, create a .env file and replace the values with your own
# Uncomment these EXPO_PUBLIC... .env variables


#* Supabase keys for the app
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-supabase-key-here

# *RevenueCat keys for the app
EXPO_PUBLIC_RC_APPLE_KEY=appl_...
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_...

#* PostHog keys for the app
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key-here
EXPO_PUBLIC_POSTHOG_HOST=your-posthog-host-here


#* Google Admob keys for the app
EXPO_PUBLIC_GOOGLE_ADMOB_IOS_APP_ID=ca-app-pub-...
EXPO_PUBLIC_GOOGLE_ADMOB_ANDROID_APP_ID=ca-app-pub-...

#* Google OAuth keys for the app
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=some-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=some-id.apps.googleusercontent.com             
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=some-id.apps.googleusercontent.com


